# Copy to `.env` and adjust as needed.
#   cp .env.example .env

# Host port mapped to the imgx HTTP server.
# The container always listens on 8080 internally; this only changes the host side.
IMGX_PORT=8080

# Host interface to bind. Default 0.0.0.0 exposes the server on all interfaces.
# Use 127.0.0.1 to restrict access to the local machine (recommended — there is no auth).
IMGX_BIND=0.0.0.0
